{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "reciclai_mobile (macOS)",
      "request": "launch",
      "type": "dart",
      "deviceId": "macos",
      "args": [
        "--dart-define=RECICLAI_API_KEY=clave-de-desarrollo-local",
        "--dart-define=RECICLAI_API_BASE_URL=http://localhost:8000"
      ]
    },
    {
      "name": "reciclai_mobile (Android emulator)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=RECICLAI_API_KEY=clave-de-desarrollo-local"
      ]
    },
    {
      "name": "reciclai_mobile (iOS simulator)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=RECICLAI_API_KEY=clave-de-desarrollo-local",
        "--dart-define=RECICLAI_API_BASE_URL=http://localhost:8000"
      ]
    },
    {
      "name": "reciclai_mobile (dispositivo físico)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=RECICLAI_API_KEY=clave-de-desarrollo-local",
        "--dart-define=RECICLAI_API_BASE_URL=http://192.168.1.11:8000"
      ]
    },
    {
      // La key real NUNCA va escrita acá (este archivo esta trackeado en git) —
      // vive en dart_define.render.json (gitignored, junto al pubspec.yaml).
      // Completa ese archivo con tu key real antes de usar esta configuracion.
      "name": "reciclai_mobile (Render)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define-from-file=dart_define.render.json"
      ]
    }
  ]
}
